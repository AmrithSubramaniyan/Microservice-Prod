{
  "info": {
    "_postman_id": "8a32b6e1-95c4-4d82-8bc1-microservices-api-gateway",
    "name": "E-Commerce Microservices (API Gateway)",
    "description": "Complete Postman collection for all microservices accessed via Spring Cloud API Gateway single entry point (http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "1.1 Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"amrit\",\n  \"email\": \"amrit@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Generate JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var token = pm.response.text();",
                  "    pm.collectionVariables.set(\"jwtToken\", token);",
                  "    console.log(\"Saved jwtToken:\", token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"amrit\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Validate Token (Bearer Token)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "validate"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Customer Service",
      "item": [
        {
          "name": "2.1 Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.id) {",
                  "        pm.collectionVariables.set(\"customerId\", res.id);",
                  "        console.log(\"Saved customerId:\", res.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amrit Surya\",\n  \"email\": \"amritsurya@example.com\",\n  \"location\": \"Chennai\",\n  \"phonenumber\": 9876543210\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.2 Get All Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.3 Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.4 Update Customer",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amrit Surya Updated\",\n  \"email\": \"amritsurya@example.com\",\n  \"location\": \"Bangalore\",\n  \"phonenumber\": 9876543210\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.5 Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Order Service",
      "item": [
        {
          "name": "3.1 Place Order (Produces Kafka Event)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"name\": \"Apple MacBook Pro M3\",\n  \"price\": 1999.00,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/placeorder",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "placeorder"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.2 Get All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Notification Service",
      "item": [
        {
          "name": "4.1 Get All Notifications (Kafka Consumer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4.2 Get Customer Notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "customer",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4.3 Notification Service Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "status"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}

